<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "easy-stun">
<!ENTITY author    "隔壁小王">
<!ENTITY version   "1.0.0">
<!ENTITY launch    "Settings/EasyStun.Main">
<!ENTITY sourceDir "/boot/config/plugins/easy-stun">
<!ENTITY pluginURL "https://raw.githubusercontent.com/wlaosj/easy-stun/main/easy-stun.plg">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY plgNAME   "&name;-&version;-x86_64">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" min="6.12.0" support="https://t.me/+7jcTMePlNVwwZjg1" icon="icon-network">

<CHANGES>
1.0.0  正式版本发布
【核心特性】
- ⭐ 深度集成 Cloudflare：自动管理 DNS 记录和页面规则
- ⭐ 无端口访问：通过 HTTPS 反向代理实现标准 443 端口访问
- ⭐ 智能跳转：Cloudflare 页面规则自动重定向到动态端口
- ⭐ 零配置 SSL：利用 Cloudflare 自动获取 HTTPS 证书
- ⭐ 域名池管理：统一管理多个域名的 DNS 和页面规则

【NAT 穿透】
- 支持 STUN 协议获取公网映射地址
- 支持 TCP/UDP 端口转发
- 自动端口检测和 WAN 有效性验证
- 连接保活机制，确保隧道稳定性
- 网络异常自动检测和重连

【管理功能】
- 集成 Web 管理界面，支持实时状态监控
- 支持多隧道实例管理
- 支持开机自启动
- 内置日志轮转机制（最大10MB，保留1个备份）
- 支持自定义 Web 端口配置
- 集成 Unraid 仪表板显示
</CHANGES>

<!-- pre-install: ensure clean run dir -->
<FILE Run="/bin/bash">
<INLINE>
set -e
rm -rf /usr/local/emhttp/plugins/easy-stun
mkdir -p /usr/local/emhttp/plugins/easy-stun/scripts
mkdir -p /boot/config/plugins/easy-stun
</INLINE>
</FILE>

<!-- copy files from source directory -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
# 从源目录复制所有文件
echo "正在创建目录结构..."

# 停止正在运行的easy-stun服务（如果存在）
echo "正在检查easy-stun服务状态..."
# 使用最可靠的进程检测方法，完全避免grep干扰
EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
if [ -n "$EASY_STUN_PIDS" ]; then
  echo "  - 检测到easy-stun服务正在运行，正在停止..."
  echo "$EASY_STUN_PIDS" | xargs kill 2>/dev/null || true
  sleep 3
  # 检查是否成功停止
  EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
  if [ -n "$EASY_STUN_PIDS" ]; then
    echo "  - 强制停止easy-stun服务..."
    echo "$EASY_STUN_PIDS" | xargs kill -9 2>/dev/null || true
    sleep 1
  fi
  echo "  ✓ easy-stun服务已停止"
else
  echo "  ✓ easy-stun服务未运行"
fi

# 创建必要的目录
mkdir -p /usr/local/emhttp/plugins/easy-stun/scripts
mkdir -p /boot/config/plugins/easy-stun
mkdir -p /usr/local/bin

# 从GitHub下载easy-stun二进制文件
echo "  - 正在从GitHub下载easy-stun二进制文件..."
BIN_URL="https://github.com/wlaosj/easy-stun/raw/refs/heads/main/easy-stun"
TMP_BIN="/tmp/easy-stun-latest"

# 添加超时和重试机制
if timeout 60 wget --timeout=30 --tries=3 -q "$BIN_URL" -O "$TMP_BIN"; then
  echo "  - 下载完成，正在安装..."
  chmod +x "$TMP_BIN"
  
  # 双重存储：U盘持久化 + 内存系统PATH
  cp -f "$TMP_BIN" /boot/config/plugins/easy-stun/easy-stun
  cp -f "$TMP_BIN" /usr/local/bin/easy-stun
  chmod +x /boot/config/plugins/easy-stun/easy-stun
  chmod +x /usr/local/bin/easy-stun
  
  rm -f "$TMP_BIN"
  echo "  ✓ easy-stun二进制文件已下载并安装（已保存到U盘和内存）"
else
  echo "  ⚠️ 下载easy-stun二进制文件失败，请检查网络连接"
  echo "  - 下载URL: $BIN_URL"
  echo "  - 临时文件: $TMP_BIN"
  echo "  - 插件将安装但需要手动下载二进制文件"
  # 清理临时文件
  rm -f "$TMP_BIN"
  
  # 创建占位文件，避免启动时出错
  touch /boot/config/plugins/easy-stun/easy-stun
  touch /usr/local/bin/easy-stun
  chmod +x /boot/config/plugins/easy-stun/easy-stun
  chmod +x /usr/local/bin/easy-stun
fi

# 创建默认配置文件（仅当不存在时）
CONF_DIR="/boot/config/plugins/easy-stun"
DATA_DIR="$CONF_DIR/data"
DEFAULT_CONF="$DATA_DIR/tunnels.json"
DEFAULT_PORT="$CONF_DIR/port.conf"

# 创建 data 目录（用于保存配置文件、证书等，日志除外）
echo "  - 创建数据目录..."
mkdir -p "$DATA_DIR"
mkdir -p "$DATA_DIR/certs"
echo "  ✓ 数据目录已创建: $DATA_DIR"

echo "  - 检查默认配置文件..."
if [ ! -f "$DEFAULT_CONF" ]; then
  echo "  - 未发现tunnels.json，创建默认配置"
  cat > "$DEFAULT_CONF" << 'EOF'
{
  "version": 1,
  "tunnels": []
}
EOF
else
  echo "  ✓ 检测到已有tunnels.json，保持不变"
fi

# 创建端口配置文件（仅当不存在时）
echo "  - 检查端口配置..."
if [ ! -f "$DEFAULT_PORT" ]; then
  echo "  - 未发现port.conf，写入默认端口 18888"
  echo "18888" > "$DEFAULT_PORT"
else
  echo "  ✓ 检测到已有port.conf，保持不变"
fi

# 注意：easy-stun 使用内置日志轮转机制（-log-max-size, -log-max-backups, -log-max-age）
# 无需额外的日志清理脚本，避免机制重复

# 创建仪表板JavaScript文件
echo "  - 正在创建仪表板JavaScript文件..."
cat > "/usr/local/emhttp/plugins/easy-stun/scripts/easy-stun-dashboard.js" << 'EOF'
/**
 * Easy-Stun Dashboard JavaScript Functions
 * 提供仪表板实时数据更新功能
 */

// 全局变量
let easyStunDashboardInterval = null;
let easyStunLastUpdate = 0;

/**
 * 刷新easy-stun仪表板数据
 */
function refreshEasyStunDashboard() {
    const now = Date.now();
    
    // 防止过于频繁的请求（最小间隔1秒）
    if (now - easyStunLastUpdate < 1000) {
        return;
    }
    
    easyStunLastUpdate = now;
    
    $.getJSON('/plugins/easy-stun/api.php?cmd=dashboard_status')
        .done(function(data) {
            updateEasyStunDashboard(data);
        })
        .fail(function(xhr, status, error) {
            console.error('Failed to fetch easy-stun dashboard data:', error);
            showEasyStunError();
        });
}

/**
 * 更新仪表板显示
 * @param {Object} data - 从API获取的数据
 */
function updateEasyStunDashboard(data) {
    if (!data) {
        showEasyStunError();
        return;
    }
    
    // 更新状态显示
    updateEasyStunStatus(data);
    
    // 更新版本信息
    updateEasyStunVersion(data);
    
    // 更新服务状态
    updateEasyStunService(data);
    
    // 更新隧道信息
    updateEasyStunTunnels(data);
    
    // 更新内存使用信息
    updateEasyStunMemory(data);
    
    // 更新运行时间信息
    updateEasyStunUptime(data);
}

/**
 * 更新easy-stun运行状态
 * @param {Object} data - 数据对象
 */
function updateEasyStunStatus(data) {
    const statusIcon = $('.easy-stun-status-icon');
    const statusText = $('.easy-stun-status-text');
    
    // 移除所有状态类
    statusIcon.removeClass('running stopped loading');
    
    if (data.running) {
        statusIcon.addClass('running');
        statusText.text(_('运行中'));
    } else {
        statusIcon.addClass('stopped');
        statusText.text(_('已停止'));
    }
}

/**
 * 更新版本信息
 * @param {Object} data - 数据对象
 */
function updateEasyStunVersion(data) {
    const versionText = $('#easy-stun-version');
    const version = data.version || _('未知');
    versionText.text(_('版本: ') + version);
}

/**
 * 更新服务状态
 * @param {Object} data - 数据对象
 */
function updateEasyStunService(data) {
    const serviceStatus = $('.easy-stun-service-status');
    
    if (data.running) {
        serviceStatus.html('<span style="color:#28a745;font-weight:bold;">' + _('运行中') + '</span>');
    } else {
        serviceStatus.html('<span style="color:#dc3545;font-weight:bold;">' + _('已停止') + '</span>');
    }
}

/**
 * 更新隧道信息
 * @param {Object} data - 数据对象
 */
function updateEasyStunTunnels(data) {
    const tunnelInfo = $('.easy-stun-tunnel-info');
    
    if (data.tunnels && data.tunnels.length > 0) {
        const runningTunnels = data.tunnels.filter(t => t.running).length;
        tunnelInfo.html('<span style="color:#28a745;">' + runningTunnels + '/' + data.tunnels.length + ' 隧道运行中</span>');
    } else {
        tunnelInfo.html('<span style="color:#6c757d;">' + _('无隧道') + '</span>');
    }
}

/**
 * 更新内存使用信息
 * @param {Object} data - 数据对象
 */
function updateEasyStunMemory(data) {
    const memoryInfo = $('.easy-stun-memory-info');
    
    if (data.running && data.memory) {
        memoryInfo.html('<span style="color:#17a2b8;">' + data.memory + '</span>');
    } else {
        memoryInfo.html('<span style="color:#6c757d;">' + _('未知') + '</span>');
    }
}

/**
 * 更新运行时间信息
 * @param {Object} data - 数据对象
 */
function updateEasyStunUptime(data) {
    const uptimeInfo = $('.easy-stun-uptime-info');
    
    if (data.running && data.uptime) {
        uptimeInfo.html('<span style="color:#28a745;">' + data.uptime + '</span>');
    } else {
        uptimeInfo.html('<span style="color:#6c757d;">' + _('未知') + '</span>');
    }
}

/**
 * 显示错误状态
 */
function showEasyStunError() {
    $('.easy-stun-status-icon').removeClass('running stopped').addClass('loading');
    $('.easy-stun-status-text').text(_('状态: 错误'));
    $('.easy-stun-service-status').text(_('错误'));
    $('.easy-stun-tunnel-info').text(_('错误'));
    $('.easy-stun-memory-info').text(_('错误'));
    $('.easy-stun-uptime-info').text(_('错误'));
}

/**
 * 启动自动刷新
 * @param {number} interval - 刷新间隔（毫秒）
 */
function startEasyStunDashboardRefresh(interval = 5000) {
    // 清除现有定时器
    if (easyStunDashboardInterval) {
        clearInterval(easyStunDashboardInterval);
    }
    
    // 立即执行一次
    refreshEasyStunDashboard();
    
    // 设置定时刷新
    easyStunDashboardInterval = setInterval(refreshEasyStunDashboard, interval);
}

/**
 * 停止自动刷新
 */
function stopEasyStunDashboardRefresh() {
    if (easyStunDashboardInterval) {
        clearInterval(easyStunDashboardInterval);
        easyStunDashboardInterval = null;
    }
}

// 页面加载完成后自动启动
$(document).ready(function() {
    // 检查是否在仪表板页面
    if ($('#tblEasyStunDash').length > 0) {
        startEasyStunDashboardRefresh(5000);
    }
});

// 页面卸载时清理定时器
$(window).on('beforeunload', function() {
    stopEasyStunDashboardRefresh();
});
EOF

chmod +x "/usr/local/emhttp/plugins/easy-stun/scripts/easy-stun-dashboard.js"
echo "  ✓ 仪表板JavaScript文件已创建"

echo "✓ 插件基础文件部署完成"
]]></INLINE>
</FILE>

<!-- WebUI index -->
<FILE Name="/usr/local/emhttp/plugins/easy-stun/index.php">
<INLINE><![CDATA[
<?php
$baseRun = '/usr/local/emhttp/plugins/easy-stun';
$scripts = $baseRun . '/scripts';
$logFile = '/var/log/easy-stun.log';
$confDir = '/boot/config/plugins/easy-stun';
$dataDir = $confDir . '/data';
$configFile = $dataDir . '/tunnels.json';
$portFile = $confDir . '/port.conf';

$cmd = isset($_POST['cmd']) ? $_POST['cmd'] : (isset($_GET['cmd']) ? $_GET['cmd'] : '');
$msg = '';

// 处理命令
if ($cmd === 'start') {
  $out = shell_exec("bash $scripts/start.sh 2>&1");
  $msg = htmlspecialchars($out ?? '');
}
if ($cmd === 'stop') {
  $out = shell_exec("bash $scripts/stop.sh 2>&1");
  $msg = htmlspecialchars($out ?? '');
}
if ($cmd === 'restart') {
  $out = shell_exec("bash $scripts/restart.sh 2>&1");
  $msg = htmlspecialchars($out ?? '');
}
if ($cmd === 'clearlog') {
  @file_put_contents($logFile, "");
  $msg = '日志已清空';
}
if ($cmd === 'save_port') {
  $port = $_POST['port'] ?? '';
  if (is_numeric($port) && $port >= 1024 && $port <= 65535) {
    if (@file_put_contents($portFile, $port) !== false) {
      $msg = '端口配置已保存: ' . htmlspecialchars($port);
    } else {
      $msg = '端口配置保存失败';
    }
  } else {
    $msg = '无效的端口号，请输入1024-65535之间的数字';
  }
}

// 开机即启动（不依赖阵列）设置
$bootFlag = '/boot/config/plugins/easy-stun/bootstart.enabled';
if ($cmd === 'set_bootstart') {
  $enable = ($_POST['enable'] ?? '') === '1';
  $goPath = '/boot/config/go';
  $begin = "# BEGIN easy-stun (do not edit)";
  $end   = "# END easy-stun";
  $block = $begin . "\n" .
    "(\n" .
    "cat <<'EOF' >/tmp/easy-stun-boot.sh\n" .
    "#!/bin/bash\n" .
    "FLAG=\"/boot/config/plugins/easy-stun/bootstart.enabled\"\n" .
    "START_SH=\"/usr/local/emhttp/plugins/easy-stun/scripts/start.sh\"\n" .
    "LOG=\"/var/log/easy-stun.log\"\n" .
    "for i in \$(seq 1 15); do\n" .
    "  if [ -x \"\$START_SH\" ]; then break; fi\n" .
    "  sleep 1\n" .
    "done\n" .
    "if [ -f \"\$FLAG\" ] && [ -x \"\$START_SH\" ]; then\n" .
    "  echo \"[easy-stun] boot detected, starting service...\" >> \"\$LOG\" 2>&1\n" .
    "  bash \"\$START_SH\" >> \"\$LOG\" 2>&1 || true\n" .
    "fi\n" .
    "rm -f /tmp/easy-stun-boot.sh\n" .
    "EOF\n" .
    "bash /tmp/easy-stun-boot.sh &\n" .
    ")\n" .
    $end . "\n";

  if ($enable) {
    if (!is_dir(dirname($bootFlag))) @mkdir(dirname($bootFlag), 0777, true);
    @file_put_contents($bootFlag, 'enabled');
    $go = file_exists($goPath) ? @file_get_contents($goPath) : "";
    if (strpos($go, $begin) !== false && strpos($go, $end) !== false) {
      $pattern = sprintf('/%s[\s\S]*?%s\n?/m', preg_quote($begin, '/'), preg_quote($end, '/'));
      $go = preg_replace($pattern, $block, $go, 1);
    } else {
      if ($go !== "" && substr($go, -1) !== "\n") $go .= "\n";
      $go .= $block;
    }
    @file_put_contents($goPath, $go);
    $msg = 'bootstart enabled (go injected)';
  } else {
    @unlink($bootFlag);
    $go = file_exists($goPath) ? @file_get_contents($goPath) : "";
    if ($go !== "") {
      $pattern = sprintf('/%s[\s\S]*?%s\n?/m', preg_quote($begin, '/'), preg_quote($end, '/'));
      $newGo = preg_replace($pattern, '', $go, 1);
      if ($newGo !== null) @file_put_contents($goPath, $newGo);
    }
    $msg = 'bootstart disabled (go cleaned)';
  }
}
// 检查标志文件是否存在，以确定复选框的初始状态
$bootstartOn = file_exists($bootFlag);

$status = shell_exec("bash $scripts/status.sh 2>&1");
$version = shell_exec("bash $scripts/version.sh 2>&1");
$logTail = file_exists($logFile) ? trim(shell_exec("tail -n 200 $logFile 2>&1")) : '';

// 获取日志文件信息
$logSize = file_exists($logFile) ? filesize($logFile) : 0;
$logSizeFormatted = formatBytes($logSize);
$logLines = file_exists($logFile) ? count(file($logFile)) : 0;

function formatBytes($size, $precision = 2) {
    $units = array('B', 'KB', 'MB', 'GB', 'TB');
    for ($i = 0; $size > 1024 && $i < count($units) - 1; $i++) {
        $size /= 1024;
    }
    return round($size, $precision) . ' ' . $units[$i];
}

// 读取当前端口配置
$currentPort = '18888';
if (file_exists($portFile)) {
  $portContent = @file_get_contents($portFile);
  if ($portContent && is_numeric(trim($portContent))) {
    $portNum = intval(trim($portContent));
    if ($portNum >= 1024 && $portNum <= 65535) {
      $currentPort = strval($portNum);
    }
  }
}

// 检查安装状态
$installStatus = '';
$binExists = file_exists('/usr/local/bin/easy-stun');
$configExists = file_exists($configFile);

if (!$binExists) {
  $installStatus = '<div class="error">❌ 缺少二进制文件，请先编译 easy-stun 项目</div>';
} elseif (!$configExists) {
  $installStatus = '<div class="success">💡 配置文件已创建，可以开始使用</div>';
}
?>
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8" />
<title>Easy-Stun</title>
<style>
body{font-family:Arial,Helvetica,sans-serif;margin:16px;color:#222}
.card{border:1px solid #ddd;border-radius:8px;padding:16px;margin-bottom:16px}
pre{background:#f7f7f7;border:1px solid #eee;border-radius:6px;padding:10px;max-height:360px;overflow:auto}
button{padding:8px 14px;margin-right:8px;cursor:pointer}
.warning{background:#fff3cd;border:1px solid #ffeaa7;color:#856404;padding:12px;border-radius:6px;margin-bottom:16px}
.error{color:#dc3545;margin:4px 0;font-size:14px}
.success{color:#28a745;margin:4px 0;font-size:14px}
</style>
<script>
function executeAction(action) {
  // 使用GET参数直接跳转
  var url = new URL(window.location);
  url.searchParams.set('cmd', action);
  window.location.href = url.toString();
}

function openWebUI() {
  // 获取当前页面的主机名
  var currentHostname = window.location.hostname;
  // 从页面中获取配置的端口
  var portInput = document.getElementById('web-port');
  var webPort = portInput ? portInput.value : '18888';
  // 构建WebUI URL
  var webUIUrl = 'http://' + currentHostname + ':' + webPort + '/';
  // 在新标签页中打开WebUI
  window.open(webUIUrl, '_blank');
}
</script>
</head>
<body>
<h2 style="display:inline;">Easy-Stun NAT穿透管理</h2>
<div style="display:inline-block;margin-left:12px;vertical-align:middle;">
  <a href="https://t.me/+7jcTMePlNVwwZjg1" target="_blank" style="display:inline-block;background:#0088cc;color:white;padding:4px 8px;border-radius:4px;text-decoration:none;font-weight:bold;font-size:12px;margin-right:8px;">
    💬 Telegram
  </a>
  <a href="https://space.bilibili.com/416291500" target="_blank" style="display:inline-block;background:#00A1D6;color:white;padding:4px 8px;border-radius:4px;text-decoration:none;font-weight:bold;font-size:12px;margin-right:8px;">
    📺 Bilibili
  </a>
  <span style="font-size:12px;color:#6c757d;">
    Easy-Stun 插件 | 作者：隔壁小王 | 功能：NAT穿透与端口暴露
  </span>
</div>
<?php if ($installStatus) { echo $installStatus; } ?>
<div class="card">
  <div>
    <b>运行状态：</b>
    <?php
      $statusText = trim($status ?? 'unknown');
      if (strpos($statusText, 'running') !== false) {
        $pid = '';
        if (preg_match('/pid=(\d+)/', $statusText, $matches)) { $pid = ' (进程ID: ' . $matches[1] . ')'; }
        echo '<span style="color:#28a745;font-weight:bold;">🟢 运行中' . $pid . '</span>';
      } elseif (strpos($statusText, 'stopped') !== false) {
        echo '<span style="color:#dc3545;font-weight:bold;">🔴 已停止</span>';
      } else {
        echo '<span style="color:#6c757d;">⚪ ' . htmlspecialchars($statusText) . '</span>';
      }
    ?>
  </div>

  <div style="margin-top:8px">
    <b>核心：</b>
    <?php if ($binExists): ?>
      <span style="color:#28a745">已安装</span> | 版本：<?= htmlspecialchars(trim($version ?? 'unknown')) ?>
    <?php else: ?>
      <span style="color:#dc3545">未安装</span> | 请先编译 easy-stun 项目
    <?php endif; ?>
  </div>

  <div style="margin-top:6px">
    <b>Web管理界面：</b>
    <button onclick="openWebUI()">打开WebUI</button>
    <span style="margin-left:8px;color:#6c757d;">
      提供完整的隧道管理功能
    </span>
  </div>

  <div style="margin-top:8px">
    <b>Web端口配置：</b>
    <form method="POST" style="display:inline-block;margin:0 8px;vertical-align:middle">
      <input type="hidden" name="cmd" value="save_port" />
