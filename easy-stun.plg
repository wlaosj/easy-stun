    $isRunning = strpos($status, 'running') !== false;
    $pid = '';
    if (preg_match('/pid=(\d+)/', $status, $matches)) {
        $pid = $matches[1];
    }
    
    return [
        'running' => $isRunning,
        'status' => trim($status),
        'version' => trim($version),
        'pid' => $pid
    ];
}

// 获取隧道信息
