<FILE Name="/usr/local/emhttp/plugins/easy-stun/api.php">
<INLINE><![CDATA[
<?php
// 轻量 API：纯文本返回，避免 emhttp 外层 HTML 包装
header('Content-Type: text/plain; charset=utf-8');

$baseRun = '/usr/local/emhttp/plugins/easy-stun';
$scripts = $baseRun . '/scripts';
$portFile = '/boot/config/plugins/easy-stun/port.conf';

$cmd = $_GET['cmd'] ?? $_POST['cmd'] ?? '';
if ($cmd === 'dashboard_status') {
  // 返回JSON格式的仪表板数据
  header('Content-Type: application/json; charset=utf-8');
  
  // 获取easy-stun状态
  $status = shell_exec("bash $scripts/status.sh 2>&1");
  $version = shell_exec("bash $scripts/version.sh 2>&1");
  
  $isRunning = strpos($status, 'running') !== false;
  $pid = '';
  if (preg_match('/pid=(\d+)/', $status, $matches)) {
    $pid = $matches[1];
  }
  
  // 获取内存使用信息
  $memoryUsage = '0 MB';
  if ($pid) {
    $memoryInfo = shell_exec("ps -o rss= -p $pid 2>/dev/null");
    if ($memoryInfo) {
      $memoryKB = intval(trim($memoryInfo));
      $memoryMB = round($memoryKB / 1024, 1);
      $memoryUsage = $memoryMB . ' MB';
    }
  }
  
  // 获取运行时间信息
  $uptime = '未知';
  if ($pid) {
    $startTime = shell_exec("ps -o lstart= -p $pid 2>/dev/null");
    if ($startTime) {
      $startTimestamp = strtotime(trim($startTime));
      if ($startTimestamp) {
        $currentTime = time();
        $diff = $currentTime - $startTimestamp;
        
        $hours = floor($diff / 3600);
        $minutes = floor(($diff % 3600) / 60);
        
        if ($hours > 0) {
          $uptime = $hours . 'h' . $minutes . 'm';
        } else {
          $uptime = $minutes . 'm';
        }
      }
    }
  }
  
  // 获取端口配置（先于隧道信息，便于尝试读取内置API）
  $port = '18888';
  if (file_exists($portFile)) {
    $portContent = @file_get_contents($portFile);
    if ($portContent && is_numeric(trim($portContent))) {
      $portNum = intval(trim($portContent));
      if ($portNum >= 1024 && $portNum <= 65535) {
        $port = strval($portNum);
      }
    }
  }

  // 获取隧道信息（优先实时API，其次本地配置）
  $tunnels = [];
  $configFile = '/boot/config/plugins/easy-stun/data/tunnels.json';
  $usedRealtime = false;
  if ($isRunning) {
    $apiUrl = 'http://127.0.0.1:' . $port . '/api/tunnels';
    $ctx = stream_context_create(['http' => ['timeout' => 1]]); // 1秒超时
    $resp = @file_get_contents($apiUrl, false, $ctx);
    if ($resp) {
      $apiData = json_decode($resp, true);
      if (is_array($apiData)) {
        // 兼容两种返回：{tunnels:[...]} 或 直接数组 [...]
        if (isset($apiData['tunnels']) && is_array($apiData['tunnels'])) {
          $tunnels = $apiData['tunnels'];
          $usedRealtime = true;
        } elseif (array_keys($apiData) === range(0, count($apiData) - 1)) {
          $tunnels = $apiData; // 直接数组
          $usedRealtime = true;
        }
      }
    }
  }
  if (!$usedRealtime && file_exists($configFile)) {
    $configData = json_decode(@file_get_contents($configFile), true);
    $tunnels = $configData['tunnels'] ?? [];
  }

  // 统一规范化运行状态字段为小写 running，便于前端统计（带启发式）
  if (is_array($tunnels)) {
    foreach ($tunnels as $i => $t) {
      $run = false;
      if (is_array($t)) {
        if (isset($t['running'])) {
          $run = (bool)$t['running'];
        } elseif (isset($t['Running'])) {
          $run = (bool)$t['Running'];
        } elseif (isset($t['status'])) {
          $run = (string)$t['status'] === 'running';
        } elseif (!empty($t['outerAddr'])) {
          // 若存在 outerAddr，近似认为该隧道已建立
          $run = true;
        }
        // 若隧道被禁用，则视为未运行
        if (isset($t['enabled']) && !$t['enabled']) { $run = false; }
        $t['running'] = $run;
        // 移除可能的大小写重复键，避免前端困惑
        unset($t['Running']);
        $tunnels[$i] = $t;
      }
    }
  }
  
  $result = [
    'running' => $isRunning,
    'status' => trim($status),
    'version' => trim($version),
    'pid' => $pid,
    'memory' => $memoryUsage,
    'uptime' => $uptime,
    'tunnels' => $tunnels,
    'port' => $port
  ];
  
  echo json_encode($result);
  exit;
}
if ($cmd === 'start') {
  $out = shell_exec("bash $scripts/start.sh 2>&1");
  echo htmlspecialchars($out ?? '');
  exit;
}
if ($cmd === 'stop') {
  $out = shell_exec("bash $scripts/stop.sh 2>&1");
  echo htmlspecialchars($out ?? '');
  exit;
}
if ($cmd === 'restart') {
  $out = shell_exec("bash $scripts/restart.sh 2>&1");
  echo htmlspecialchars($out ?? '');
  exit;
}
echo 'unknown command';
]]></INLINE>
</FILE>

<!-- scripts -->
<FILE Name="/usr/local/emhttp/plugins/easy-stun/scripts/start.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
BIN="/usr/local/bin/easy-stun"
CONF_DIR="/boot/config/plugins/easy-stun"
DATA_DIR="$CONF_DIR/data"
CONFIG_FILE="$DATA_DIR/tunnels.json"
PORT_FILE="$CONF_DIR/port.conf"
LOG_FILE="/var/log/easy-stun.log"
PID_FILE="/var/run/easy-stun.pid"

# 读取端口配置
WEB_PORT="18888"
if [ -f "$PORT_FILE" ]; then
  WEB_PORT=$(cat "$PORT_FILE" 2>/dev/null | tr -d '\n\r' || echo "18888")
  # 验证端口号
  if ! [[ "$WEB_PORT" =~ ^[0-9]+$ ]] || [ "$WEB_PORT" -lt 1024 ] || [ "$WEB_PORT" -gt 65535 ]; then
    echo "无效的端口号: $WEB_PORT，使用默认端口 18888" >> "$LOG_FILE" 2>&1
    WEB_PORT="18888"
  fi
fi

# 防重复启动检查（必须在最前面）
if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$PID" ] && ps -p "$PID" >/dev/null 2>&1; then
    echo "running (pid $PID)"
    exit 0
  fi
fi

# 检查并恢复核心文件（重启后内存文件丢失）
if [ ! -f "$BIN" ] || [ ! -s "$BIN" ]; then
  UDISK_BIN="/boot/config/plugins/easy-stun/easy-stun"
  if [ -f "$UDISK_BIN" ] && [ -s "$UDISK_BIN" ]; then
    echo "检测到核心文件缺失，从U盘恢复..." >> "$LOG_FILE" 2>&1
    mkdir -p /usr/local/bin
    cp -f "$UDISK_BIN" "$BIN"
    chmod +x "$BIN"
    echo "核心文件已从U盘恢复到内存" >> "$LOG_FILE" 2>&1
  else
    echo "二进制文件缺失或为空: $BIN" >> "$LOG_FILE" 2>&1
    echo "二进制文件缺失或为空: $BIN"
    echo "请手动下载 easy-stun 二进制文件到: $UDISK_BIN"
    echo "下载地址: https://github.com/wlaosj/easy-stun/raw/refs/heads/main/easy-stun"
    exit 1
  fi
fi

if [ ! -x "$BIN" ]; then
  echo "二进制不可执行: $BIN" >&2
  exit 1
fi

# 确保数据目录存在
mkdir -p "$DATA_DIR"
mkdir -p "$DATA_DIR/certs"

# 检查配置文件
if [ ! -f "$CONFIG_FILE" ]; then
  echo "配置文件缺失: $CONFIG_FILE" >&2
  exit 1
fi

# 后台启动（使用绝对路径，无需切换工作目录）
# 使用新版本的参数系统：
# -data-dir: 统一数据目录（包含所有配置文件）
# -log-file: 日志文件路径（内存中，保护U盘，内置日志轮转）
# -log-level: 日志级别（支持 info/INFO，不区分大小写）
# -log-max-size: 日志文件最大大小（MB）
# -log-max-backups: 日志文件最大备份数
# -log-max-age: 日志文件最大保存天数
# 注意：使用 -log-file 参数后，程序内部管理日志，无需重定向
nohup "$BIN" \
  -web \
  -web-addr "0.0.0.0:$WEB_PORT" \
  -data-dir "$DATA_DIR" \
  -log-file "$LOG_FILE" \
  -log-level info \
  -log-max-size 10 \
  -log-max-backups 1 \
  -log-max-age 7 \
  > /dev/null 2>&1 &
NEWPID=$!
echo $NEWPID > "$PID_FILE"
sleep 1

if ps -p "$NEWPID" >/dev/null 2>&1; then
  echo "started (pid $NEWPID)"
  exit 0
else
  echo "start failed, see $LOG_FILE" >&2
  exit 1
fi
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/easy-stun/scripts/stop.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
PID_FILE="/var/run/easy-stun.pid"

# 优先按 pidfile 停止
if [ -f "$PID_FILE" ]; then
  PID=$(cat "$PID_FILE" 2>/dev/null || true)
  if [ -n "$PID" ] && ps -p "$PID" >/dev/null 2>&1; then
    kill "$PID" 2>/dev/null || true
  fi
fi

# 兜底按进程名停止
EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
if [ -n "$EASY_STUN_PIDS" ]; then
  # 等待优雅退出
  for i in $(seq 1 5); do
    EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
    if [ -n "$EASY_STUN_PIDS" ]; then
      sleep 1
    else
      break
    fi
  done
  # 仍存活则强杀
  EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
  if [ -n "$EASY_STUN_PIDS" ]; then
    echo "$EASY_STUN_PIDS" | xargs kill -9 2>/dev/null || true
  fi
fi

# 清理 pidfile（若进程已不存在）
if [ -f "$PID_FILE" ]; then
  if ! ps -p $(cat "$PID_FILE" 2>/dev/null || echo 0) >/dev/null 2>&1; then
    rm -f "$PID_FILE"
  fi
fi

echo "stopped"
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/easy-stun/scripts/restart.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
SCRIPT_DIR="/usr/local/emhttp/plugins/easy-stun/scripts"

bash "$SCRIPT_DIR/stop.sh" || true
sleep 1
bash "$SCRIPT_DIR/start.sh"
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/easy-stun/scripts/status.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
PID_FILE="/var/run/easy-stun.pid"
STATUS="stopped"; PID=""
EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
if [ -n "$EASY_STUN_PIDS" ]; then 
  STATUS="running"
  PID=$(echo "$EASY_STUN_PIDS" | head -n1)
fi
echo "status=$STATUS pid=$PID"
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/easy-stun/scripts/version.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
set -e
BIN="/usr/local/bin/easy-stun"
if [ -f "$BIN" ]; then 
  # 尝试获取版本信息（容错处理）
  OUT=$("$BIN" -version 2>&1 || true)
  if echo "$OUT" | grep -qi "flag provided but not defined"; then
    echo "unknown"
  elif [ -n "$OUT" ]; then
    echo "$OUT" | head -n 1
  else
    echo "unknown"
  fi
else 
  echo "binary missing"
fi
]]></INLINE>
</FILE>

