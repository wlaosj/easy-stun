<script type="text/javascript" src="/plugins/easy-stun/scripts/easy-stun-dashboard.js"></script>
<script type="text/javascript">
function refreshEasyStunDashboard() {
    $.getJSON('/plugins/easy-stun/api.php?cmd=dashboard_status', function(data) {
        if (data) {
            // 保存API数据到全局变量，供其他函数使用
            window.easyStunLastData = data;
            
            // 更新状态显示
            var statusIcon = $('.easy-stun-status-icon');
            var statusText = $('.easy-stun-status-text');
            var versionText = $('#easy-stun-version');
            var serviceStatus = $('.easy-stun-service-status');
            var tunnelInfo = $('.easy-stun-tunnel-info');
            var memoryInfo = $('.easy-stun-memory-info');
            var uptimeInfo = $('.easy-stun-uptime-info');
            
            // 状态图标和文本
            statusIcon.removeClass('running stopped loading').addClass(data.running ? 'running' : 'stopped');
            statusText.text(data.running ? _('运行中') : _('已停止'));
            
            // 顶部版本信息
            versionText.text(_('版本: ') + (data.version || _('未知')));
            
            // 运行状态
            if (data.running) {
                serviceStatus.html('<span style="color:#28a745;font-weight:bold;">' + _('运行中') + '</span>');
            } else {
                serviceStatus.html('<span style="color:#dc3545;font-weight:bold;">' + _('已停止') + '</span>');
            }
            
            // 隧道信息
            if (data.tunnels && data.tunnels.length > 0) {
                var runningTunnels = data.tunnels.filter(t => t.running).length;
                tunnelInfo.html('<span style="color:#28a745;">' + runningTunnels + '/' + data.tunnels.length + ' 隧道运行中</span>');
            } else {
                tunnelInfo.html('<span style="color:#6c757d;">' + _('无隧道') + '</span>');
            }
            
            // 内存使用信息
            if (data.running && data.memory) {
                memoryInfo.html('<span style="color:#17a2b8;">' + data.memory + '</span>');
            } else {
                memoryInfo.html('<span style="color:#6c757d;">' + _('未知') + '</span>');
            }
            
            // 运行时间信息
            if (data.running && data.uptime) {
                uptimeInfo.html('<span style="color:#28a745;">' + data.uptime + '</span>');
            } else {
                uptimeInfo.html('<span style="color:#6c757d;">' + _('未知') + '</span>');
            }
        }
    }).fail(function() {
        // 更新失败时的显示
        $('.easy-stun-status-icon').removeClass('running stopped').addClass('loading');
        $('.easy-stun-status-text').text(_('状态: 错误'));
        $('.easy-stun-service-status').text(_('错误'));
        $('.easy-stun-tunnel-info').text(_('错误'));
        $('.easy-stun-memory-info').text(_('错误'));
        $('.easy-stun-uptime-info').text(_('错误'));
    });
}

// 按钮操作函数
function easyStunAction(action) {
    switch(action) {
        case 'start':
        case 'stop':
        case 'restart':
            // 静默处理操作，不跳转页面
            var actionText = '';
            switch(action) {
                case 'start': actionText = _('启动'); break;
                case 'stop': actionText = _('停止'); break;
                case 'restart': actionText = _('重启'); break;
            }
            
            // 显示操作状态
            $('.easy-stun-status-text').text(_('状态: ') + actionText + _('中...'));
            $('.easy-stun-status-icon').removeClass('running stopped').addClass('loading');
            
            // 发送操作请求
            $.get('/plugins/easy-stun/api.php?cmd=' + action, function(response) {
                // 操作完成后刷新状态
                setTimeout(function() {
                    refreshEasyStunDashboard();
                }, 1000);
            }).fail(function() {
                // 操作失败时显示错误
                $('.easy-stun-status-text').text(_('状态: 操作失败'));
                $('.easy-stun-status-icon').removeClass('running stopped loading').addClass('stopped');
            });
            break;
        case 'ui':
            // 打开WebUI
            var currentHostname = window.location.hostname;
            // 从API数据中获取端口信息，如果没有则使用默认端口
            var port = '18888';
            if (window.easyStunLastData && window.easyStunLastData.port) {
                port = window.easyStunLastData.port;
            }
            var webUIUrl = 'http://' + currentHostname + ':' + port + '/';
            window.open(webUIUrl, '_blank');
            break;
    }
}

// 页面加载时立即刷新一次
$(document).ready(function() {
    refreshEasyStunDashboard();
    
    // 每5秒刷新一次
    setInterval(refreshEasyStunDashboard, 5000);
});
</script>
]]></INLINE>
</FILE>

<!-- post-install: setup menu entry -->
<FILE Run="/bin/bash">
<INLINE>
set -e
echo "Easy-Stun plugin installed. Persistent path: /boot/config/plugins/easy-stun"
</INLINE>
</FILE>

<!-- version cleanup -->
<FILE Run="/bin/bash">
<INLINE>
set -e
echo "Cleanup completed"
</INLINE>
</FILE>

<!-- remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
set -e
echo "正在卸载 Easy-Stun 插件..."

# 停止easy-stun进程
echo "  - 正在停止 Easy-Stun 服务..."
EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
if [ -n "$EASY_STUN_PIDS" ]; then
  echo "    检测到easy-stun进程，正在停止..."
  echo "$EASY_STUN_PIDS" | xargs kill -9 2>/dev/null || true
  # 等待进程完全停止
  sleep 2
  EASY_STUN_PIDS=$(ps -eo pid,comm,args | awk '$2 ~ /easy-stun$/ || $3 ~ /easy-stun$/ {print $1}' || true)
  if [ -n "$EASY_STUN_PIDS" ]; then
    echo "    强制停止easy-stun进程..."
    echo "$EASY_STUN_PIDS" | xargs kill -9 2>/dev/null || true
    sleep 1
  fi
  echo "  ✓ Easy-Stun 服务已停止"
else
  echo "  ✓ Easy-Stun 服务未运行"
fi

# 清理PID文件
echo "  - 清理进程文件..."
rm -f /var/run/easy-stun.pid
echo "  ✓ 进程文件已清理"

# 清理二进制文件
echo "  - 清理二进制文件..."
rm -f /usr/local/bin/easy-stun
echo "  ✓ 二进制文件已清理"

# 清理插件目录
echo "  - 清理插件目录..."
rm -rf /usr/local/emhttp/plugins/easy-stun
rm -rf /boot/config/plugins/easy-stun
echo "  ✓ 插件目录已清理"

# 清理内存临时目录
echo "  - 清理内存临时目录..."
rm -rf /var/tmp/easy-stun-* /tmp/easy-stun-*
echo "  ✓ 内存临时目录已清理"

# 清理系统覆盖层文件（仅限本插件命名空间）
echo "  - 清理系统文件..."
rm -rf /var/local/overlay/usr/local/emhttp/plugins/easy-stun
rm -f /var/local/overlay/usr/local/emhttp/plugins/easy-stun.*
echo "  ✓ 系统文件已清理"

# 清理日志文件
echo "  - 清理日志文件..."
rm -f /var/log/easy-stun.log
echo "  ✓ 日志文件已清理"

# 清理临时文件
echo "  - 清理临时文件..."
rm -f /tmp/easy-stun
echo "  ✓ 临时文件已清理"

# 清理开机即启动注入与标志
echo "  - 清理开机启动配置..."
sed -i "/^# BEGIN easy-stun (do not edit)$/,/^# END easy-stun$/d" /boot/config/go 2>/dev/null || true
rm -f /boot/config/plugins/easy-stun/bootstart.enabled
echo "  ✓ 开机启动配置已清理"

echo ""
echo "🎉 Easy-Stun 插件卸载完成！"
echo "   所有相关文件和配置已完全清理。"
]]></INLINE>
</FILE>

</PLUGIN>
